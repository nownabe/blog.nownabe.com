---
import PostEntry from "./PostEntry.astro";
import { groupByYear, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  years: string[];
  currentYear?: string;
}

const { posts, years, currentYear } = Astro.props;
const groups = groupByYear(posts);
---

<div class="list">
  <ul class="years" aria-label="Years">
    {
      years.map((year) => (
        <li>
          <a href={`/${year}/`} aria-current={year === currentYear ? "page" : undefined}>
            {year}
          </a>
        </li>
      ))
    }
  </ul>
  <div>
    {
      groups.map(({ year, posts }) => (
        <section aria-labelledby={`y${year}`}>
          <h2 class="year-heading" id={`y${year}`}>
            {year}
          </h2>
          {posts.map((post) => (
            <PostEntry post={post} />
          ))}
        </section>
      ))
    }
    <slot />
  </div>
</div>

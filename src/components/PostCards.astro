---
import { formatDate, postImage, postPath, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  class?: string;
}

const { posts, class: className } = Astro.props;
---

<div id="cards" class={className}>
  {
    posts.map((post) => (
      <article class="card">
        <a href={postPath(post)} aria-label={post.data.title} />
        <div class="card-img">
          <img src={postImage(post)} alt={post.data.title} loading="lazy" width="384" height="200" />
        </div>
        <div class="card-title">
          <h2>{post.data.title}</h2>
          <p class="date">{formatDate(post.data.date)}</p>
        </div>
      </article>
    ))
  }
</div>

---
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION, DEFAULT_IMAGE } from "../lib/posts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE_DESCRIPTION, image = DEFAULT_IMAGE } = Astro.props;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: "/tags/", label: "Tags", current: path.startsWith("/tags/") },
  { href: "https://nownabe.com", label: "About", current: false },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title={SITE_TITLE} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/vnd.microsoft.icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Noto+Sans+JP:wght@400;700&family=JetBrains+Mono:wght@400&display=swap"
    />
    <meta name="author" content="nownabe" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nownabe" />
    <meta name="twitter:creator" content="@nownabe" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PWWXNZ0XM3" />
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-PWWXNZ0XM3");
          </script>
        </>
      )
    }
  </head>
  <body>
    <div class="site">
      <header class="site-header">
        <p class="logo"><a href="/">{SITE_TITLE}</a></p>
        <nav aria-label="Site">
          {nav.map((item) => <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="author">
          <a href="https://nownabe.com"><img src="/img/profile_icon_2022.jpg" alt="" width="56" height="56" /></a>
          <div>
            <p class="name"><a href="https://nownabe.com">Shogo Watanabe</a></p>
            <p>A dog lover. Software Engineer at <a href="https://kwork.studio">Knowledge Work</a>. Ex-Googler.</p>
            <p>Opinions are my own, not views of my employer.</p>
          </div>
        </div>
        <p class="copyright">© 2016 Shogo Watanabe</p>
      </footer>
    </div>
  </body>
</html>

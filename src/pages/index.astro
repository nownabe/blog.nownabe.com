---
import Base from "../layouts/Base.astro";
import PostEntry from "../components/PostEntry.astro";
import YearColumn from "../components/YearColumn.astro";
import { getPublishedPosts, groupByYear } from "../lib/posts";

const LATEST = 10;

const posts = await getPublishedPosts();
const years = groupByYear(posts).map(({ year }) => year);
---

<Base>
  <YearColumn years={years}>
    <h1 class="year-heading">Latest</h1>
    {posts.slice(0, LATEST).map((post) => <PostEntry post={post} />)}
  </YearColumn>
</Base>

---
import type { Page } from "astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts, PAGE_SIZE, type Post } from "../lib/posts";

const posts = await getPublishedPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const page: Page<Post> = {
  data: posts.slice(0, PAGE_SIZE),
  start: 0,
  end: Math.min(PAGE_SIZE, posts.length) - 1,
  size: PAGE_SIZE,
  total: posts.length,
  currentPage: 1,
  lastPage,
  url: {
    current: "/",
    prev: undefined,
    next: lastPage > 1 ? "/page/2/" : undefined,
    first: undefined,
    last: lastPage > 1 ? `/page/${lastPage}/` : undefined,
  },
};
---

<PostList page={page} />

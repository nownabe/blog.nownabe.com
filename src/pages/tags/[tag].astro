---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PostEntry from "../../components/PostEntry.astro";
import { getPublishedPosts, groupByTag, type Post } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return [...groupByTag(posts)].map(([slug, group]) => ({
    params: { tag: slug },
    props: group,
  }));
}) satisfies GetStaticPaths;

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`}>
  <div class="list">
    <div>
      <h1 class="list-title">#{tag}</h1>
      <p class="note">{posts.length} 本の記事。<a href="/tags/">タグ一覧</a></p>
      {posts.map((post) => <PostEntry post={post} />)}
    </div>
  </div>
</Base>

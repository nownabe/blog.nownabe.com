---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PostCards from "../../components/PostCards.astro";
import { getPublishedPosts, groupByTag, type Post } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return [...groupByTag(posts)].map(([slug, group]) => ({
    params: { tag: slug },
    props: group,
  }));
}) satisfies GetStaticPaths;

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`}>
  <div class="tag-container content">
    <h1>#{tag}</h1>
    <p class="date">{posts.length} posts</p>
  </div>
  <PostCards posts={posts} class="content" />
</Base>

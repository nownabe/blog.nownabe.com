---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import "katex/dist/katex.min.css";
import Base from "../layouts/Base.astro";
import TagList from "../components/TagList.astro";
import {
  banner,
  bannerOpensBody,
  cardPath,
  excerpt,
  formatDate,
  formatYearMonth,
  getPublishedPosts,
  legacyPath,
  postPath,
  readingMinutes,
  relatedPosts,
  type Post,
} from "../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.flatMap((post, i) => {
    const page = {
      params: { slug: postPath(post).slice(1, -1) },
      props: { post, related: relatedPosts(post, posts), newer: posts[i - 1], older: posts[i + 1] },
    };
    const legacy = legacyPath(post);
    return legacy ? [page, { params: { slug: legacy.slice(1, -1) }, props: { redirectTo: postPath(post) } }] : [page];
  });
}) satisfies GetStaticPaths;

type Props = { post: Post; related: Post[]; newer?: Post; older?: Post } | { redirectTo: string };

if ("redirectTo" in Astro.props) return Astro.redirect(Astro.props.redirectTo, 301);

const { post, related, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== "footnote-label");
const bannerSrc = bannerOpensBody(post) ? undefined : banner(post);
---

<Base
  title={post.data.title}
  description={excerpt(post)}
  image={cardPath(post)}
  type="article"
  canonical={postPath(post)}
>
  <div class="article">
    <article class="article-main">
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-meta mono">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true"> · </span>{readingMinutes(post)} min read
      </p>
      <TagList tags={post.data.tags} class="article-tags" />
      {bannerSrc && <img class="banner" src={bannerSrc} alt="" width="800" height="420" />}
      {
        toc.length > 0 && (
          <details class="toc toc-inline">
            <summary>Contents</summary>
            <ol>
              {toc.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>

    {
      toc.length > 0 && (
        <nav class="toc toc-side" aria-label="Contents" data-toc>
          <p class="toc-label">Contents</p>
          <ol>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`} data-slug={h.slug}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>

  <nav class="read-next" aria-label="Read next">
    <dl>
      {
        newer && (
          <div>
            <dt class="mono">Newer</dt>
            <dd>
              <a href={postPath(newer)}>{newer.data.title}</a>
            </dd>
          </div>
        )
      }
      {
        older && (
          <div>
            <dt class="mono">Older</dt>
            <dd>
              <a href={postPath(older)}>{older.data.title}</a>
            </dd>
          </div>
        )
      }
      {
        related.length > 0 && (
          <div>
            <dt class="mono">Related</dt>
            {related.map((r) => (
              <dd>
                <a href={postPath(r)}>{r.data.title}</a>
                <span class="date mono">{formatYearMonth(r.data.date)}</span>
              </dd>
            ))}
          </div>
        )
      }
    </dl>
  </nav>
</Base>

<script>
  // Mark the table-of-contents entry for the section currently at the top of the viewport.
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    const items = new Map(
      [...toc.querySelectorAll<HTMLLIElement>("li[data-slug]")].map((li) => [li.dataset.slug!, li]),
    );
    const headings = [...items.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    let current: HTMLLIElement | undefined;
    const update = () => {
      const line = window.scrollY + 96;
      const active = headings.filter((h) => h.offsetTop <= line).at(-1) ?? headings[0];
      const li = active && items.get(active.id);
      if (li === current) return;
      current?.removeAttribute("aria-current");
      li?.setAttribute("aria-current", "true");
      current = li;
    };
    update();
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
  }
</script>

---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import TagList from "../components/TagList.astro";
import {
  banner,
  bannerOpensBody,
  excerpt,
  formatDate,
  formatYearMonth,
  getPublishedPosts,
  postPath,
  readingMinutes,
  relatedPosts,
  socialImage,
  type Post,
} from "../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== "footnote-label");
const url = new URL(postPath(post), Astro.site).href;
const bannerSrc = bannerOpensBody(post) ? undefined : banner(post);
---

<Base title={post.data.title} description={excerpt(post)} image={socialImage(post)}>
  <div class="article">
    <article class="article-main">
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-meta mono">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true"> · </span>{readingMinutes(post)} min read
      </p>
      <TagList tags={post.data.tags} class="article-tags" />
      {bannerSrc && <img class="banner" src={bannerSrc} alt="" width="800" height="420" />}
      {
        toc.length > 0 && (
          <details class="toc toc-inline">
            <summary>Contents</summary>
            <ol>
              {toc.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>

    {
      toc.length > 0 && (
        <nav class="toc toc-side" aria-label="Contents" data-toc>
          <p class="toc-label">Contents</p>
          <ol>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`} data-slug={h.slug}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>

  <div class="after-article">
    <ul class="share">
      <li>
        <a
          href={`https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(post.data.title)}&via=nownabe`}
          rel="noopener">Share on X</a
        >
      </li>
      <li><a href={`https://b.hatena.ne.jp/entry/${url}`} rel="noopener">Hatena Bookmark</a></li>
    </ul>
    {
      related.length > 0 && (
        <section class="related">
          <h2>Related posts</h2>
          <ol>
            {related.map((r) => (
              <li>
                <span class="date mono">{formatYearMonth(r.data.date)}</span>
                <a href={postPath(r)}>{r.data.title}</a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</Base>

<script>
  // Mark the table-of-contents entry for the section currently at the top of the viewport.
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    const items = new Map(
      [...toc.querySelectorAll<HTMLLIElement>("li[data-slug]")].map((li) => [li.dataset.slug!, li]),
    );
    const headings = [...items.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    let current: HTMLLIElement | undefined;
    const update = () => {
      const line = window.scrollY + 96;
      const active = headings.filter((h) => h.offsetTop <= line).at(-1) ?? headings[0];
      const li = active && items.get(active.id);
      if (li === current) return;
      current?.removeAttribute("aria-current");
      li?.setAttribute("aria-current", "true");
      current = li;
    };
    update();
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
  }
</script>

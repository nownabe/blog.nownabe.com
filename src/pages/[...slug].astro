---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCards from "../components/PostCards.astro";
import { excerpt, formatDate, getPublishedPosts, postImage, postPath, relatedPosts, type Post } from "../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const shareUrl = new URL(postPath(post), Astro.site).href;
---

<Base title={post.data.title} description={excerpt(post)} image={postImage(post)}>
  <div class="article-container">
    <article class="content">
      <div class="article-title">
        <h1><a href={postPath(post)}>{post.data.title}</a></h1>
        <p class="date">Posted on {formatDate(post.data.date)}</p>
      </div>
      <div class="article-body">
        <Content />
      </div>
    </article>
    <div class="article-left"></div>
    <div class="article-right">
      {
        toc.length > 0 && (
          <nav class="article-toc" aria-label="Table of contents">
            <ul>
              {toc.map((h) => (
                <li class={`toc-depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>

  <div slot="navigation" class="navigation-container">
    <nav class="content">
      <div class="sns-buttons">
        <ul>
          <li>
            <a
              class="twitter-share-button"
              href={`https://twitter.com/share?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.data.title)}&via=nownabe`}
              data-via="nownabe"
              data-related="nownabe">Tweet</a
            >
          </li>
          <li>
            <a
              class="hatena-bookmark-button"
              href={`https://b.hatena.ne.jp/entry/${shareUrl}`}
              data-hatena-bookmark-layout="standard-balloon"
              data-hatena-bookmark-lang="ja"
              title="このエントリーをはてなブックマークに追加"
            >
              <img
                src="https://b.st-hatena.com/images/entry-button/button-only@2x.png"
                alt="このエントリーをはてなブックマークに追加"
                width="20"
                height="20"
                style="border: none;"
              />
            </a>
          </li>
        </ul>
      </div>
      {
        related.length > 0 && (
          <>
            <h2 class="related-posts">related posts</h2>
            <PostCards posts={related} />
          </>
        )
      }
    </nav>
    <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
    <script is:inline async src="https://b.st-hatena.com/js/bookmark_button.js"></script>
  </div>
</Base>

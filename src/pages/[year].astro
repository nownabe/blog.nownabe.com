---
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import PostEntry from "../components/PostEntry.astro";
import YearColumn from "../components/YearColumn.astro";
import { getPublishedPosts, groupByYear, type Post } from "../lib/posts";

// Hugo published section pages at /2016/ … /2023/; they are the year archives now.
export const getStaticPaths = (async () => {
  const groups = groupByYear(await getPublishedPosts());
  const years = groups.map(({ year }) => year);
  return groups.map(({ year, posts }) => ({ params: { year }, props: { year, posts, years } }));
}) satisfies GetStaticPaths;

interface Props {
  year: string;
  posts: Post[];
  years: string[];
}

const { year, posts, years } = Astro.props;
---

<Base title={year}>
  <YearColumn years={years} currentYear={year}>
    <h1 class="year-heading">{year}</h1>
    {posts.map((post) => <PostEntry post={post} />)}
  </YearColumn>
</Base>

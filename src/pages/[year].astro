---
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import PostCards from "../components/PostCards.astro";
import { getPublishedPosts, type Post } from "../lib/posts";

// Hugo published (empty) section pages at /2016/ … /2023/; keep the URLs alive as year archives.
export const getStaticPaths = (async () => {
  const byYear = new Map<string, Post[]>();
  for (const post of await getPublishedPosts()) {
    const year = post.id.match(/^(\d{4})\//)?.[1];
    if (!year) continue;
    byYear.set(year, [...(byYear.get(year) ?? []), post]);
  }
  return [...byYear].map(([year, posts]) => ({ params: { year }, props: { year, posts } }));
}) satisfies GetStaticPaths;

interface Props {
  year: string;
  posts: Post[];
}

const { year, posts } = Astro.props;
---

<Base title={year}>
  <div class="tag-container content">
    <h1>{year}</h1>
    <p class="date">{posts.length} posts</p>
  </div>
  <PostCards posts={posts} class="content" />
</Base>

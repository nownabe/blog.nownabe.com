---
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import PostEntry from "../components/PostEntry.astro";
import { getPublishedPosts, groupByYear, type Post } from "../lib/posts";

// Hugo published section pages at /2016/ … /2023/; keep the URLs alive as year archives.
export const getStaticPaths = (async () => {
  return groupByYear(await getPublishedPosts()).map(({ year, posts }) => ({
    params: { year },
    props: { year, posts },
  }));
}) satisfies GetStaticPaths;

interface Props {
  year: string;
  posts: Post[];
}

const { year, posts } = Astro.props;
---

<Base title={`${year}年の記事`}>
  <div class="list">
    <div>
      <h1 class="list-title">{year}</h1>
      <p class="note">{posts.length} 本の記事。<a href={`/#y${year}`}>記事一覧で他の年も見る</a></p>
      {posts.map((post) => <PostEntry post={post} />)}
    </div>
  </div>
</Base>

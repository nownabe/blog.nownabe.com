---
import type { GetStaticPaths } from "astro";
import { getPublishedPosts } from "../../lib/posts";

// Hugo paginated the top page at /page/N/ (10 posts a page). The top page now
// lists every post, so those URLs redirect there instead of disappearing.
export const getStaticPaths = (async () => {
  const pages = Math.ceil((await getPublishedPosts()).length / 10);
  return Array.from({ length: pages }, (_, i) => ({ params: { page: String(i + 1) } }));
}) satisfies GetStaticPaths;

return Astro.redirect("/", 301);
---
